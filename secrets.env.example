# Copy this file to secrets.env (git-ignored) and paste your Alpaca PAPER keys.
# Never paste keys into code, chat, screenshots or commits. If you do, regenerate them.
APCA_API_KEY_ID=your_paper_key_id_here
APCA_API_SECRET_KEY=your_paper_secret_here
# Paper trading host. The bot refuses any host that does not contain "paper-api".
APCA_API_BASE_URL=https://paper-api.alpaca.markets
